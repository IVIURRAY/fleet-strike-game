# Backend image.
#
# The builder does a full workspace install (it is discarded, so its size does
# not matter) and bundles the server with esbuild.
#
# The runtime stage does NOT copy pnpm's node_modules. Those are a tree of
# relative symlinks into a `.pnpm` store, which is fragile to relocate across
# stages. Instead a minimal manifest is derived from the backend's own
# package.json - dropping the @fleet-strike/* entries, which esbuild has already
# inlined - and installed flat with npm. That leaves only the four real runtime
# dependencies in the final image.

FROM node:20-alpine AS builder

RUN corepack enable

WORKDIR /app

# Manifests first so dependency installation caches independently of source.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/types/package.json ./packages/types/
COPY packages/config/package.json ./packages/config/
COPY packages/utils/package.json ./packages/utils/
COPY packages/ecs/package.json ./packages/ecs/
COPY packages/renderer/package.json ./packages/renderer/
COPY apps/backend/package.json ./apps/backend/
COPY apps/frontend/package.json ./apps/frontend/

RUN pnpm install --frozen-lockfile

COPY packages ./packages
COPY apps/backend ./apps/backend

RUN pnpm turbo run build --filter=@fleet-strike/backend

# Derive the runtime manifest. Workspace packages are already bundled into
# dist/index.js, so only third-party dependencies need installing.
RUN node -e "\
const pkg = require('./apps/backend/package.json'); \
const deps = Object.fromEntries( \
  Object.entries(pkg.dependencies).filter(([name]) => !name.startsWith('@fleet-strike/')) \
); \
require('fs').writeFileSync('/tmp/package.json', JSON.stringify({ \
  name: 'fleet-strike-backend', version: pkg.version, private: true, \
  type: 'module', dependencies: deps \
}, null, 2)); \
"


FROM node:20-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY --from=builder /tmp/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund \
  && npm cache clean --force \
  && chown -R node:node /app

COPY --from=builder --chown=node:node /app/apps/backend/dist ./dist

# The node image already provides an unprivileged `node` user.
USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
